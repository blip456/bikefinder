# All optional. The app works without any of these — they only widen what can be scraped.

# Cookie header from a signed-in Facebook session. Marketplace is a logged-in,
# client-rendered surface, so without this the Facebook source will report an
# auth wall instead of returning results.
# FACEBOOK_COOKIE="c_user=...; xs=...; datr=..."

# Optional rendering/scraping proxy for sites behind Cloudflare or heavy JS.
# Must contain {url}, which is replaced with the URL-encoded target.
# SCRAPE_PROXY_URL="https://api.example-proxy.com/render?token=XXX&url={url}"
